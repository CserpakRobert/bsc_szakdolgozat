@startuml

class MariaDBContext {
    + MariaDBContext(options : DbContextOptions<MariaDBContext>)
    + Users : DbSet<User> <<get>> <<set>>
    + Competitions : DbSet<Competition> <<get>> <<set>>
    + Submissions : DbSet<Submission> <<get>> <<set>>
    + MoviesDetails : DbSet<MovieDetails> <<get>> <<set>>
    + MusicDetails : DbSet<MusicDetails> <<get>> <<set>>
    + Groups : DbSet<Group> <<get>> <<set>>
    + JoinRequests : DbSet<OpenGroupJoinRequests> <<get>> <<set>>
    + SubmissionInvites : DbSet<SubmissionInvites> <<get>> <<set>>
    + CollaboratedSubmissions : DbSet<CollaboratedSubmissions> <<get>> <<set>>
    + Moderators : DbSet<Moderators> <<get>> <<set>>
    + SubmissionVotes : DbSet<SubmissionVotes> <<get>> <<set>>
    + UserParticipateGroups : DbSet<UserParticipateGroups> <<get>> <<set>>
}
IdentityDbContext <|-- MariaDBContext
@enduml
