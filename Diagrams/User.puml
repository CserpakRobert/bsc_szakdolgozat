@startuml
class UserService {
    + UserService(httpContextAccessor:IHttpContextAccessor, \n userManager:UserManager<User>, context:MariaDBContext, \n configuration:IConfiguration, signInManager:SignInManager<User>)
    + <<async>> RegisterUser(model:RegisterModel) : Task<bool>
    + <<async>> GetUserByName(name:string) : Task<User?>
    + <<async>> LoginUser(model:LoginModel) : Task<LoginDetails?>
    + <<virtual>> <<async>> GetLoggedInUser() : Task<User?>
    + <<async>> IsCreatorInCompetition(competitionId:int, userId:int) : Task<bool>
    + <<async>> IsModeratorInCompetition(competitionId:int, userId:int) : Task<bool>
    + <<async>> CanSubmitOnCompetition(competitionId:int, userId:int) : Task<bool>
}
class UserController {
    + UserController(userService:UserService)
    + <<async>> Register(model:RegisterModel) : Task<IActionResult>
    + <<async>> UserById(name:string) : Task<IActionResult>
    + <<async>> Login(model:LoginModel) : Task<IActionResult>
}
ControllerBase <|-- UserController
UserController <-- UserService
@enduml
