@startuml
class GroupController {
    + GroupController(groupService:GroupService, competitionService:CompetitionService, userService:UserService)
    + <<async>> CreateClosed(competitionId:int, createGroup:CreateGroupDTO) : Task<IActionResult>
    + <<async>> CreateClosed(id:int) : Task<IActionResult>
    + <<async>> GetSmallDetails(competitionId:int, page:int) : Task<IActionResult>
    + <<async>> GetSmallDetails(competitionId:int) : Task<IActionResult>
    + <<async>> GetSmallDetails(username:string, page:int) : Task<IActionResult>
    + <<async>> Invite(groupId:int, invite:InviteDTO) : Task<IActionResult>
    + <<async>> IsInvited(groupId:int) : Task<IActionResult>
    + <<async>> Invites(groupId:int) : Task<IActionResult>
    + <<async>> DeleteInvite(groupId:int, invite:InviteDTO) : Task<IActionResult>
    + <<async>> AcceptInvite(groupId:int) : Task<IActionResult>
    + <<async>> DeclineInvite(groupId:int) : Task<IActionResult>
    + <<async>> RequestJoin(groupId:int, request:GroupRequestDTO) : Task<IActionResult>
    + <<async>> RequestJoin(groupId:int) : Task<IActionResult>
    + <<async>> Requests(groupId:int) : Task<IActionResult>
    + <<async>> GetDescription(groupId:int, invite:InviteDTO) : Task<IActionResult>
    + <<async>> DeleteRequest(groupId:int, invite:InviteDTO) : Task<IActionResult>
    + <<async>> AcceptRequest(groupId:int, invite:InviteDTO) : Task<IActionResult>
}
class GroupService {
    + GroupService( userService:UserService, context:MariaDBContext)
    + <<virtual>> <<async>> CanJoin(competitionId:int, userId:int?) : Task<bool>
    + <<virtual>> <<async>> GroupSmallDetails(competitionId:int, page:int) : Task<GetSmallDetailsDTO>
    + <<virtual>> <<async>> IsOwner(groupId:int, userName:string?) : Task<bool?>
    + <<virtual>> <<async>> GetGroupsCompetition(groupId:int) : Task<int?>
    + <<virtual>> <<async>> Create(competitionId:int, createGroup:CreateGroupDTO) : Task<int>
    + <<virtual>> <<async>> GetById(groupId:int) : Task<GetGroupDTO>
    + <<virtual>> <<async>> Invite(groupId:int, userName:string) : Task<bool>
    + <<virtual>> <<async>> getInvites(groupId:int) : Task<IEnumerable<string>>
    + <<virtual>> <<async>> getRequests(groupId:int) : Task<IEnumerable<string>>
    + <<virtual>> <<async>> DeleteInvite(groupId:int, userName:string) : Task<bool>
    + <<virtual>> <<async>> RequestJoin(groupId:int, description:string) : Task<bool>
    + <<virtual>> <<async>> DeleteRequest(groupId:int, userName:string) : Task<bool>
    + <<virtual>> <<async>> HasJoin(groupId:int) : Task<bool>
    + <<virtual>> <<async>> AcceptRequest(groupId:int, userName:string) : Task<bool>
    + <<virtual>> <<async>> IsInvited(groupId:int) : Task<bool>
    + <<virtual>> <<async>> AcceptInvite(groupId:int) : Task<bool>
    + <<virtual>> <<async>> DeclineInvite(groupId:int) : Task<bool>
    + <<virtual>> <<async>> GetDescription(groupId:int, userName:string) : Task<string>
    + <<virtual>> <<async>> GetInvitedGroups() : Task<GetSmallDetailsDTO>
    + <<virtual>> <<async>> UserOpenGroups(username:string, page:int) : Task<object?>
}
ControllerBase <|-- GroupController
GroupController <-- GroupService
GroupService <- UserService
@enduml