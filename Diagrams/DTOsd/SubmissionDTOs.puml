@startuml

class CreateMusicDetailsModel {
    + Link : string <<get>> <<set>> = null!
}

class CreateMovieDetailsModel {
    + TrailerLink : string <<get>> <<set>> = null!
    + MovieLink : string <<get>> <<set>> = null!
}

class CreateShortStoryDetailsModel {
    + Story : string <<get>> <<set>> = null!
}
interface IModifySubmission {
    + Id : int <<get>> <<set>>
    + Title : string <<get>> <<set>>
    + Description : string <<get>> <<set>>
}

class ModifyMovieDetails {
    + Id : int <<get>> <<set>>
    + Title : string <<get>> <<set>> = null!
    + Description : string <<get>> <<set>> = null!
    + MovieLink : string? <<get>> <<set>>
    + TrailerLink : string? <<get>> <<set>>
}

class ModifyMusicDetails {
    + Id : int <<get>> <<set>>
    + Title : string <<get>> <<set>> = null!
    + Description : string <<get>> <<set>> = null!
    + Link : string? <<get>> <<set>>
}

class ModifyShortStoryDetails {
    + Id : int <<get>> <<set>>
    + Title : string <<get>> <<set>> = null!
    + Description : string <<get>> <<set>> = null!
    + Story : string? <<get>> <<set>>
}
IModifySubmission <|-- ModifyMovieDetails
IModifySubmission <|-- ModifyMusicDetails
IModifySubmission <|-- ModifyShortStoryDetails
class GetSusbmission {
    + Id : int <<get>> <<set>>
    + Title : string <<get>> <<set>> = null!
    + Description : string <<get>> <<set>> = null!
    + IsSubmitted : bool <<get>> <<set>>
    + Votes : int <<get>> <<set>>
    + Placement : int <<get>> <<set>>
    + CanVote : bool <<get>> <<set>>
    + HasVote : bool <<get>> <<set>>
    + MusicDetails : CreateMusicDetailsModel? <<get>> <<set>>
    + MovieDetails : CreateMovieDetailsModel? <<get>> <<set>>
    + ShortStoryDetails : CreateShortStoryDetailsModel? <<get>> <<set>>
    + CreatorName : string <<get>> <<set>> = null!
    + ParticipateNames : ICollection<string> <<get>> <<set>> = []
}


class CreateSubmissionModel {
    + CompetitionId : int <<get>> <<set>>
    + Title : string <<get>> <<set>> = null!
    + Description : string <<get>> <<set>> = null!
    + musicDetails : CreateMusicDetailsModel? <<get>> <<set>>
    + MovieDetails : CreateMovieDetailsModel? <<get>> <<set>>
    + ShortStoryDetails : CreateShortStoryDetailsModel? <<get>> <<set>>
    + InvitedUsers : ICollection<string> <<get>> <<set>> = []
}

class SubmissionListGetModel {
    + UserName : string? <<get>> <<set>>
    + CompetitionId : int? <<get>> <<set>>
    + Phase : string? <<get>> <<set>>
    + SortByPlacement : bool <<get>> <<set>>
    + SortByVoteCount : bool <<get>> <<set>>
    + SortByDate : bool <<get>> <<set>>
    + Page : int <<get>> <<set>>
}

class SubmissionListModel {
    + pageCount : int <<get>> <<set>>
    + Submissions : ICollection<SubmissionListDetailsModel> <<get>> <<set>> = []
}

class SubmissionListDetailsModel {
    + Id : int <<get>> <<set>>
    + Title : string <<get>> <<set>> = ""
    + Type : string <<get>> <<set>> = ""
    + Phase : string <<get>> <<set>> = ""
    + Placement : int <<get>> <<set>>
    + VoteCount : int <<get>> <<set>>
}





@enduml
